{
  "version": 2,
  "on_missing_column": "error",
  "mutation_type_column": "mut_type_general",
  "unconfigured_mutation_types": "drop",
  "mutation_type_map": {
    "Insertion": "INDEL",
    "Deletion": "INDEL",
    "SNV": "Mismatch",
    "continuous_MNV": "Mismatch",
    "noncontinuous_MNV": "Mismatch"
  },
  "basic": [
    {"column": "CMP", "operator": ">", "threshold": 0.5, "instruction": "Posterior probability of a mosaic mutation."},
    {"column": "muttype2", "operator": "in", "threshold": ["homhet", "hethom"], "instruction": "Retain lower-error zygosity transitions."},
    {"column": "alleles_mut_type", "operator": "in", "threshold": ["Insertion", "Deletion", "SNV"], "instruction": "Mutation classes enabled by the default profile."},
    {"column": "max_mosaic_barcode_rc", "operator": "==", "threshold": 1, "instruction": "Maximum mutant read count per cell."},
    {"column": "used_read_num_in_genotyping", "operator": ">=", "threshold": 10, "instruction": "Minimum genotyping depth."}
  ],
  "by_mutation_type": {
    "INDEL": {
      "filters": [
        {"column": "stutter_ratio", "operator": "<", "threshold": 0.1},
        {"column": "mut_mis", "operator": "<=", "threshold": 0.5},
        {"column": "overall_mean_mapQ", "operator": ">=", "threshold": 50},
        {"column": "mut_mapQ_mean", "operator": ">=", "threshold": 50},
        {"column": "overall_mean_flanking_sbs_num_per_bp", "operator": "<=", "threshold": 0.005},
        {"column": "mut_mean_flanking_sbs_num_per_bp", "operator": "<=", "threshold": 0.005},
        {"column": "uncallable_frac", "operator": "<=", "threshold": 0.8, "missing_values": "pass", "instruction": "Apply when population callability is available; retain loci when it was not supplied."},
        {
          "label": "Homopolymer INDEL must exceed the noise model",
          "any": [
            {"column": "MOTIF_length", "operator": ">", "threshold": 1},
            {
              "all": [
                {"column": "MOTIF_length", "operator": "==", "threshold": 1},
                {"column": "binomial_noise_p_value", "operator": "<", "threshold": 0.05}
              ]
            }
          ]
        }
      ]
    },
    "Mismatch": {
      "filters": [
        {"column": "mut_mean_baseq", "operator": ">=", "threshold": 30},
        {
          "label": "Shared mismatches require support from both strands",
          "any": [
            {"column": "mut_type_share", "operator": "==", "threshold": "Cell-specific"},
            {
              "all": [
                {"column": "mut_type_share", "operator": "==", "threshold": "Share"},
                {"column": "mut_strand_fraction", "operator": "<", "threshold": 1}
              ]
            }
          ]
        }
      ]
    }
  },
  "final": [
    {"column": "celltype_count_mosaic", "operator": "==", "threshold": 1},
    {"column": "na_celltype_rc_mosaic", "operator": "==", "threshold": 0}
  ]
}
